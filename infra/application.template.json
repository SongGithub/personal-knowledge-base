{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Google-protected KB MCP HTTP application with scoped retrieval and raw-note capture. Requires foundation, approved runtime secret permission and a built code artifact.",
  "Parameters": {
    "ProjectName": {
      "Type": "String",
      "Default": "pkb",
      "AllowedPattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "MinLength": 2,
      "MaxLength": 16
    },
    "Environment": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    },
    "ReleaseBucket": {
      "Type": "String"
    },
    "ReleaseKey": {
      "Type": "String",
      "AllowedPattern": "^releases/[0-9a-f]{64}[.]zip$"
    },
    "ReleaseVersion": {
      "Type": "String"
    },
    "VaultBucket": {
      "Type": "String"
    },
    "IndexBucket": {
      "Type": "String"
    },
    "ControlTable": {
      "Type": "String"
    },
    "ApiExecutionRoleArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[a-z0-9-]+:iam::[0-9]{12}:role/[a-zA-Z0-9+=,.@_/-]+$"
    },
    "AuthSecretArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[a-z0-9-]+:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[a-zA-Z0-9/_+=.@-]+$"
    },
    "OwnerGoogleSubject": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1
    },
    "ClientRedirectUris": {
      "Type": "String",
      "NoEcho": true,
      "Description": "JSON list of exact allowed MCP client callback URIs; no wildcard defaults."
    },
    "HttpApiId": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9]+$",
      "Description": "API identity anchored by the separately reviewed trust bootstrap."
    },
    "IngestionExecutionRoleArn": {
      "Type": "String"
    },
    "IngestionQueueArn": {
      "Type": "String"
    },
    "EnableIngestion": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "CustomDomainName": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "Description": "Optional public MCP hostname in a domain you control."
    },
    "CustomDomainCertificateArn": {
      "Type": "String",
      "Default": "arn:aws:acm:ap-southeast-2:000000000000:certificate/00000000-0000-0000-0000-000000000000",
      "AllowedPattern": "^arn:aws:acm:ap-southeast-2:[0-9]{12}:certificate/[a-f0-9-]+$",
      "Description": "Issued ACM public certificate in ap-southeast-2 for CustomDomainName."
    }
  },
  "Resources": {
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${ProjectName}-${Environment}-api"
        },
        "Role": {
          "Ref": "ApiExecutionRoleArn"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "cloud_kb.api.handler",
        "MemorySize": 512,
        "Timeout": 25,
        "ReservedConcurrentExecutions": 2,
        "Code": {
          "S3Bucket": {
            "Ref": "ReleaseBucket"
          },
          "S3Key": {
            "Ref": "ReleaseKey"
          },
          "S3ObjectVersion": {
            "Ref": "ReleaseVersion"
          }
        },
        "Environment": {
          "Variables": {
            "PKB_BASE_URL": {
              "Fn::If": [
                "CustomDomainEnabled",
                {"Fn::Sub": "https://${CustomDomainName}"},
                {"Fn::Sub": "https://${HttpApiId}.execute-api.${AWS::Region}.${AWS::URLSuffix}"}
              ]
            },
            "PKB_VAULT_BUCKET": {
              "Ref": "VaultBucket"
            },
            "PKB_INDEX_BUCKET": {
              "Ref": "IndexBucket"
            },
            "PKB_CONTROL_TABLE": {
              "Ref": "ControlTable"
            },
            "PKB_OWNER_SUB": {
              "Ref": "OwnerGoogleSubject"
            },
            "PKB_SECRET_ARN": {
              "Ref": "AuthSecretArn"
            },
            "PKB_CLIENT_REDIRECT_URIS": {
              "Ref": "ClientRedirectUris"
            },
            "FASTMCP_LOG_LEVEL": "WARNING"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ]
      }
    },
    "ProxyIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApiId"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 29000
      }
    },
    "ProxyRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApiId"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "ProxyIntegration"
              }
            ]
          ]
        }
      }
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApiId"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 5
        }
      }
    },
    "CustomApiDomain": {
      "Type": "AWS::ApiGatewayV2::DomainName",
      "Condition": "CustomDomainEnabled",
      "Properties": {
        "DomainName": {"Ref": "CustomDomainName"},
        "DomainNameConfigurations": [{
          "EndpointType": "REGIONAL",
          "CertificateArn": {"Ref": "CustomDomainCertificateArn"},
          "SecurityPolicy": "TLS_1_2"
        }],
        "RoutingMode": "API_MAPPING_ONLY",
        "Tags": {"Project": {"Ref": "ProjectName"}, "Environment": {"Ref": "Environment"}}
      }
    },
    "CustomApiMapping": {
      "Type": "AWS::ApiGatewayV2::ApiMapping",
      "Condition": "CustomDomainEnabled",
      "DependsOn": "DefaultStage",
      "Properties": {
        "ApiId": {"Ref": "HttpApiId"},
        "DomainName": {"Ref": "CustomApiDomain"},
        "Stage": "$default"
      }
    },
    "AllowHttpApi": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApiId}/*"
        }
      }
    },
    "IngestionFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${ProjectName}-${Environment}-ingestion"
        },
        "Role": {
          "Ref": "IngestionExecutionRoleArn"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "cloud_kb.ingestion.handler",
        "MemorySize": 1024,
        "Timeout": 900,
        "ReservedConcurrentExecutions": 1,
        "Code": {
          "S3Bucket": {
            "Ref": "ReleaseBucket"
          },
          "S3Key": {
            "Ref": "ReleaseKey"
          },
          "S3ObjectVersion": {
            "Ref": "ReleaseVersion"
          }
        },
        "Environment": {
          "Variables": {
            "PKB_VAULT_BUCKET": {
              "Ref": "VaultBucket"
            },
            "PKB_INDEX_BUCKET": {
              "Ref": "IndexBucket"
            },
            "PKB_CONTROL_TABLE": {
              "Ref": "ControlTable"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ]
      }
    },
    "IngestionEventSource": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Ref": "IngestionQueueArn"
        },
        "FunctionName": {
          "Ref": "IngestionFunction"
        },
        "BatchSize": 10,
        "MaximumBatchingWindowInSeconds": 30,
        "Enabled": {
          "Fn::If": [
            "IngestionEnabled",
            true,
            false
          ]
        }
      }
    }
  },
  "Outputs": {
    "DefaultMcpEndpoint": {
      "Value": {
        "Fn::Sub": "https://${HttpApiId}.execute-api.${AWS::Region}.${AWS::URLSuffix}/mcp"
      }
    },
    "McpEndpoint": {
      "Value": {
        "Fn::If": [
          "CustomDomainEnabled",
          {"Fn::Sub": "https://${CustomDomainName}/mcp"},
          {"Fn::Sub": "https://${HttpApiId}.execute-api.${AWS::Region}.${AWS::URLSuffix}/mcp"}
        ]
      }
    },
    "GoogleRedirectUri": {
      "Value": {
        "Fn::If": [
          "CustomDomainEnabled",
          {"Fn::Sub": "https://${CustomDomainName}/auth/callback"},
          {"Fn::Sub": "https://${HttpApiId}.execute-api.${AWS::Region}.${AWS::URLSuffix}/auth/callback"}
        ]
      }
    },
    "CustomDomainRecordTarget": {
      "Condition": "CustomDomainEnabled",
      "Value": {"Fn::GetAtt": ["CustomApiDomain", "RegionalDomainName"]}
    },
    "CustomDomainHostedZoneId": {
      "Condition": "CustomDomainEnabled",
      "Value": {"Fn::GetAtt": ["CustomApiDomain", "RegionalHostedZoneId"]}
    }
  },
  "Rules": {
    "CustomDomainRequiresCertificate": {
      "Assertions": [{
        "Assert": {"Fn::Or": [
          {"Fn::Equals": [{"Ref": "CustomDomainName"}, ""]},
          {"Fn::Not": [{"Fn::Equals": [{"Ref": "CustomDomainCertificateArn"}, "arn:aws:acm:ap-southeast-2:000000000000:certificate/00000000-0000-0000-0000-000000000000"]}]}
        ]},
        "AssertDescription": "Set an issued Sydney ACM certificate whenever a custom hostname is configured."
      }]
    },
    "CertificateRequiresCustomDomain": {
      "Assertions": [{
        "Assert": {"Fn::Or": [
          {"Fn::Equals": [{"Ref": "CustomDomainCertificateArn"}, "arn:aws:acm:ap-southeast-2:000000000000:certificate/00000000-0000-0000-0000-000000000000"]},
          {"Fn::Not": [{"Fn::Equals": [{"Ref": "CustomDomainName"}, ""]}]}
        ]},
        "AssertDescription": "A custom-domain certificate requires its matching hostname."
      }]
    }
  },
  "Conditions": {
    "IngestionEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableIngestion"
        },
        "true"
      ]
    },
    "CustomDomainEnabled": {
      "Fn::Not": [{"Fn::Equals": [{"Ref": "CustomDomainName"}, ""]}]
    }
  }
}
