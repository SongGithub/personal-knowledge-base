{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One-time GitHub OIDC trust and bounded CloudFormation deployment roles for the private KB foundation.",
  "Parameters": {
    "ProjectName": {
      "Type": "String",
      "Default": "pkb",
      "MinLength": 2,
      "MaxLength": 16,
      "AllowedPattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "Environment": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    },
    "GitHubOidcSubject": {
      "Type": "String",
      "AllowedPattern": "^repo:[A-Za-z0-9_.@-]+/[A-Za-z0-9_.@-]+:ref:refs/heads/[A-Za-z0-9_./-]+$",
      "Description": "Exact branch subject, including immutable owner/repository IDs when enabled. Wildcards, pull requests, tags and environments are not accepted."
    },
    "ExistingGitHubOidcProviderArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:iam::[0-9]{12}:oidc-provider/token[.]actions[.]githubusercontent[.]com$"
    },
    "ApprovedEmbeddingModelArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:bedrock:[a-z0-9-]+::foundation-model/[a-zA-Z0-9._:-]+$"
    },
    "AuthSecretArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[a-zA-Z0-9/_+=.@-]+$"
    },
    "EnableMockSeeding": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "CreateGitHubProvider": {
      "Fn::Equals": [
        {
          "Ref": "ExistingGitHubOidcProviderArn"
        },
        ""
      ]
    },
    "HasApprovedModel": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApprovedEmbeddingModelArn"
            },
            ""
          ]
        }
      ]
    },
    "HasAuthSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AuthSecretArn"
            },
            ""
          ]
        }
      ]
    },
    "AllowMockSeeding": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnableMockSeeding"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "Environment"
            },
            "dev"
          ]
        }
      ]
    }
  },
  "Resources": {
    "GitHubOidcProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateGitHubProvider",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "RuntimePermissionsBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ManagedPolicyName": {
          "Fn::Sub": "${ProjectName}-${Environment}-runtime-boundary"
        },
        "Description": "Maximum permissions for KB runtime roles; no infrastructure, IAM, release-bucket or role-assumption authority.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:PutObject"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-vault-${AWS::AccountId}-${AWS::Region}/notes/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-vault-${AWS::AccountId}-${AWS::Region}/attachments/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-indexes-${AWS::AccountId}-${AWS::Region}/indexes/*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${ProjectName}-${Environment}-control"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "sqs:SendMessage",
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:ChangeMessageVisibility",
                "sqs:GetQueueAttributes"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${ProjectName}-${Environment}-ingestion"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-${Environment}-api:*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-${Environment}-ingestion:*"
                }
              ]
            },
            {
              "Fn::If": [
                "HasApprovedModel",
                {
                  "Effect": "Allow",
                  "Action": "bedrock:InvokeModel",
                  "Resource": {
                    "Ref": "ApprovedEmbeddingModelArn"
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Fn::If": [
                "HasAuthSecret",
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "AuthSecretArn"
                  },
                  "Condition": {
                    "ArnEquals": {
                      "aws:PrincipalArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProjectName}-${Environment}-api"
                      }
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "CloudFormationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ProjectName}-${Environment}-cfn-execution"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ProvisionKbFoundation",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ProjectBuckets",
                  "Effect": "Allow",
                  "Action": [
                    "s3:CreateBucket",
                    "s3:DeleteBucket",
                    "s3:GetBucketLocation",
                    "s3:ListBucket",
                    "s3:GetBucketPolicy",
                    "s3:PutBucketPolicy",
                    "s3:DeleteBucketPolicy",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:PutBucketPublicAccessBlock",
                    "s3:GetBucketVersioning",
                    "s3:PutBucketVersioning",
                    "s3:GetEncryptionConfiguration",
                    "s3:PutEncryptionConfiguration",
                    "s3:GetBucketOwnershipControls",
                    "s3:PutBucketOwnershipControls",
                    "s3:GetLifecycleConfiguration",
                    "s3:PutLifecycleConfiguration",
                    "s3:GetBucketTagging",
                    "s3:PutBucketTagging",
                    "s3:GetAccelerateConfiguration",
                    "s3:GetAnalyticsConfiguration",
                    "s3:GetBucketCORS",
                    "s3:GetInventoryConfiguration",
                    "s3:GetBucketLogging",
                    "s3:GetMetricsConfiguration",
                    "s3:GetBucketNotification",
                    "s3:GetReplicationConfiguration",
                    "s3:GetBucketWebsite",
                    "s3:GetBucketObjectLockConfiguration",
                    "s3:ListTagsForResource",
                    "s3:GetBucketAbac",
                    "s3:GetIntelligentTieringConfiguration",
                    "s3:GetBucketMetadataTableConfiguration"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-vault-${AWS::AccountId}-${AWS::Region}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-indexes-${AWS::AccountId}-${AWS::Region}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-releases-${AWS::AccountId}-${AWS::Region}"
                    }
                  ]
                },
                {
                  "Sid": "ProjectControlTable",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:CreateTable",
                    "dynamodb:UpdateTable",
                    "dynamodb:DeleteTable",
                    "dynamodb:DescribeTable",
                    "dynamodb:UpdateContinuousBackups",
                    "dynamodb:DescribeContinuousBackups",
                    "dynamodb:UpdateTimeToLive",
                    "dynamodb:DescribeTimeToLive",
                    "dynamodb:TagResource",
                    "dynamodb:UntagResource",
                    "dynamodb:ListTagsOfResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${ProjectName}-${Environment}-control"
                  }
                },
                {
                  "Sid": "ProjectQueues",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:CreateQueue",
                    "sqs:DeleteQueue",
                    "sqs:GetQueueUrl",
                    "sqs:GetQueueAttributes",
                    "sqs:SetQueueAttributes",
                    "sqs:TagQueue",
                    "sqs:UntagQueue",
                    "sqs:ListQueueTags"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${ProjectName}-${Environment}-ingestion"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${ProjectName}-${Environment}-ingestion-dlq"
                    }
                  ]
                },
                {
                  "Sid": "ProjectLogGroups",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:DeleteLogGroup",
                    "logs:PutRetentionPolicy",
                    "logs:DeleteRetentionPolicy",
                    "logs:TagResource",
                    "logs:UntagResource",
                    "logs:ListTagsForResource",
                    "logs:TagLogGroup",
                    "logs:UntagLogGroup",
                    "logs:ListTagsLogGroup"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-${Environment}-api*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-${Environment}-ingestion*"
                    }
                  ]
                },
                {
                  "Sid": "RegionalLogMetadata",
                  "Effect": "Allow",
                  "Action": "logs:DescribeLogGroups",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                },
                {
                  "Sid": "CreateOnlyBoundedRuntimeRoles",
                  "Effect": "Allow",
                  "Action": [
                    "iam:CreateRole",
                    "iam:PutRolePermissionsBoundary"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProjectName}-${Environment}-api"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProjectName}-${Environment}-ingestion"
                    }
                  ],
                  "Condition": {
                    "ArnEquals": {
                      "iam:PermissionsBoundary": {
                        "Ref": "RuntimePermissionsBoundary"
                      }
                    }
                  }
                },
                {
                  "Sid": "ManageOnlyRuntimeRolePolicies",
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetRole",
                    "iam:UpdateRole",
                    "iam:UpdateRoleDescription",
                    "iam:UpdateAssumeRolePolicy",
                    "iam:DeleteRole",
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:GetRolePolicy",
                    "iam:ListRolePolicies",
                    "iam:ListAttachedRolePolicies",
                    "iam:TagRole",
                    "iam:UntagRole",
                    "iam:ListRoleTags"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProjectName}-${Environment}-api"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProjectName}-${Environment}-ingestion"
                    }
                  ]
                },
                {
                  "Sid": "CodeReleaseRead",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-releases-${AWS::AccountId}-${AWS::Region}/releases/*"
                  }
                },
                {
                  "Sid": "ManageOnlyApiFunction",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:CreateFunction",
                    "lambda:GetFunction",
                    "lambda:GetFunctionConfiguration",
                    "lambda:UpdateFunctionCode",
                    "lambda:UpdateFunctionConfiguration",
                    "lambda:DeleteFunction",
                    "lambda:AddPermission",
                    "lambda:RemovePermission",
                    "lambda:GetPolicy",
                    "lambda:PutFunctionConcurrency",
                    "lambda:DeleteFunctionConcurrency",
                    "lambda:GetFunctionConcurrency",
                    "lambda:TagResource",
                    "lambda:UntagResource",
                    "lambda:ListTags",
                    "lambda:GetFunctionCodeSigningConfig",
                    "lambda:GetFunctionRecursionConfig",
                    "lambda:GetRuntimeManagementConfig",
                    "lambda:GetFunctionScalingConfig"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${ProjectName}-${Environment}-api"
                  }
                },
                {
                  "Sid": "PassOnlyApiRuntime",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProjectName}-${Environment}-api"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "lambda.amazonaws.com"
                    }
                  }
                },
                {
                  "Sid": "ManageOnlyAnchoredHttpApi",
                  "Effect": "Allow",
                  "Action": [
                    "apigateway:GET",
                    "apigateway:POST",
                    "apigateway:PUT",
                    "apigateway:PATCH",
                    "apigateway:DELETE"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}::/apis/${HttpApiAnchor}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}::/apis/${HttpApiAnchor}/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}::/tags/arn:${AWS::Partition}:apigateway:${AWS::Region}::/apis/${HttpApiAnchor}/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "GitHubDeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ProjectName}-${Environment}-github-deploy"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateGitHubProvider",
                    {
                      "Ref": "GitHubOidcProvider"
                    },
                    {
                      "Ref": "ExistingGitHubOidcProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Ref": "GitHubOidcSubject"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeployOnlyKbFoundation",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "PlanOnlyWithProvisioningRole",
                  "Effect": "Allow",
                  "Action": "cloudformation:CreateChangeSet",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ProjectName}-${Environment}-foundation/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ProjectName}-${Environment}-application/*"
                    }
                  ],
                  "Condition": {
                    "ArnEquals": {
                      "cloudformation:RoleArn": {
                        "Fn::GetAtt": [
                          "CloudFormationExecutionRole",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Sid": "OperateOnlyKbStacks",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DeleteChangeSet",
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:GetTemplateSummary",
                    "cloudformation:ListChangeSets",
                    "cloudformation:TagResource",
                    "cloudformation:UntagResource"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ProjectName}-${Environment}-foundation/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ProjectName}-${Environment}-application/*"
                    }
                  ]
                },
                {
                  "Sid": "TemplateValidation",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:ValidateTemplate",
                    "cloudformation:GetTemplateSummary"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "PassOnlyProvisioningRole",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CloudFormationExecutionRole",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                },
                {
                  "Sid": "UploadOnlyCodeReleases",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-releases-${AWS::AccountId}-${AWS::Region}/releases/*"
                  }
                },
                {
                  "Fn::If": [
                    "AllowMockSeeding",
                    {
                      "Sid": "SeedOnlyMockObjects",
                      "Effect": "Allow",
                      "Action": [
                        "s3:PutObject",
                        "s3:GetObject"
                      ],
                      "Resource": [
                        {
                          "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-vault-${AWS::AccountId}-${AWS::Region}/notes/Resources/MCP Demo/Mock orchard.md"
                        },
                        {
                          "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-indexes-${AWS::AccountId}-${AWS::Region}/indexes/mock/*"
                        }
                      ]
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "AllowMockSeeding",
                    {
                      "Sid": "SeedOnlyMockPointer",
                      "Effect": "Allow",
                      "Action": [
                        "dynamodb:GetItem",
                        "dynamodb:PutItem"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${ProjectName}-${Environment}-control"
                      },
                      "Condition": {
                        "ForAllValues:StringEquals": {
                          "dynamodb:LeadingKeys": [
                            "INDEX#ACTIVE"
                          ]
                        },
                        "Null": {
                          "dynamodb:LeadingKeys": "false"
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Sid": "ReadOnlyBootstrapIdentifiers",
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ProjectName}-${Environment}-bootstrap/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HttpApiAnchor": {
      "Type": "AWS::ApiGatewayV2::Api",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${ProjectName}-${Environment}-mcp"
        },
        "ProtocolType": "HTTP",
        "Tags": {
          "Project": {
            "Ref": "ProjectName"
          },
          "Environment": {
            "Ref": "Environment"
          }
        }
      }
    }
  },
  "Outputs": {
    "GitHubDeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "GitHubDeploymentRole",
          "Arn"
        ]
      }
    },
    "CloudFormationExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "CloudFormationExecutionRole",
          "Arn"
        ]
      }
    },
    "RuntimePermissionsBoundaryArn": {
      "Value": {
        "Ref": "RuntimePermissionsBoundary"
      }
    },
    "GitHubOidcProviderArn": {
      "Value": {
        "Fn::If": [
          "CreateGitHubProvider",
          {
            "Ref": "GitHubOidcProvider"
          },
          {
            "Ref": "ExistingGitHubOidcProviderArn"
          }
        ]
      }
    },
    "TrustedGitHubSubject": {
      "Value": {
        "Ref": "GitHubOidcSubject"
      }
    },
    "HttpApiId": {
      "Value": {
        "Ref": "HttpApiAnchor"
      }
    },
    "HttpApiEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApiAnchor",
          "ApiEndpoint"
        ]
      }
    },
    "AuthSecretArn": {
      "Value": {
        "Ref": "AuthSecretArn"
      }
    }
  }
}
