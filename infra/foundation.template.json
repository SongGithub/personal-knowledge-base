{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private KB foundation: retained storage, control records, ingestion queues and runtime roles. No application endpoint or model deployment.",
  "Parameters": {
    "ProjectName": {
      "Type": "String",
      "Default": "pkb",
      "MinLength": 2,
      "MaxLength": 16,
      "AllowedPattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "Environment": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    },
    "EnablePointInTimeRecovery": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 14,
      "AllowedValues": [
        7,
        14,
        30,
        60,
        90
      ]
    },
    "ExecutionRolePermissionsBoundaryArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:iam::[0-9]{12}:policy/.+$",
      "Description": "Optional existing runtime-role boundary; this stack does not create or widen it."
    },
    "ApprovedEmbeddingModelArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:bedrock:[a-z0-9-]+::foundation-model/[a-zA-Z0-9._:-]+$",
      "Description": "Optional approved regional foundation-model ARN. Empty grants no model invocation. Inference profiles need a later explicit policy."
    },
    "AuthSecretArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[a-zA-Z0-9/_+=.@-]+$"
    }
  },
  "Conditions": {
    "IsProduction": {
      "Fn::Equals": [
        {
          "Ref": "Environment"
        },
        "prod"
      ]
    },
    "EnableRecovery": {
      "Fn::Equals": [
        {
          "Ref": "EnablePointInTimeRecovery"
        },
        "true"
      ]
    },
    "HasRoleBoundary": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ExecutionRolePermissionsBoundaryArn"
            },
            ""
          ]
        }
      ]
    },
    "HasApprovedEmbeddingModel": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApprovedEmbeddingModelArn"
            },
            ""
          ]
        }
      ]
    },
    "HasAuthSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AuthSecretArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${ProjectName}-${Environment}-vault-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Purpose",
            "Value": "canonical-knowledge"
          }
        ],
        "NotificationConfiguration": {
          "QueueConfigurations": [
            {
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "IngestionQueue",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "notes/"
                    },
                    {
                      "Name": "suffix",
                      "Value": ".md"
                    }
                  ]
                }
              }
            },
            {
              "Event": "s3:ObjectRemoved:*",
              "Queue": {
                "Fn::GetAtt": [
                  "IngestionQueue",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "notes/"
                    },
                    {
                      "Name": "suffix",
                      "Value": ".md"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "DependsOn": "IngestionQueuePolicy"
    },
    "DataBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "IndexBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${ProjectName}-${Environment}-indexes-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Purpose",
            "Value": "private-derived-indexes"
          }
        ]
      }
    },
    "IndexBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": {
          "Ref": "IndexBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "IndexBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${IndexBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ReleaseBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${ProjectName}-${Environment}-releases-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Purpose",
            "Value": "code-releases-no-corpus"
          }
        ]
      }
    },
    "ReleaseBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": {
          "Ref": "ReleaseBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ReleaseBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ReleaseBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ControlTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${ProjectName}-${Environment}-control"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "DeletionProtectionEnabled": {
          "Fn::If": [
            "IsProduction",
            true,
            false
          ]
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": {
            "Fn::If": [
              "EnableRecovery",
              true,
              false
            ]
          }
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ExpiresAt",
          "Enabled": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ]
      }
    },
    "IngestionDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${ProjectName}-${Environment}-ingestion-dlq"
        },
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "RedriveAllowPolicy": {
          "redrivePermission": "byQueue",
          "sourceQueueArns": [
            {
              "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${ProjectName}-${Environment}-ingestion"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ]
      }
    },
    "IngestionQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${ProjectName}-${Environment}-ingestion"
        },
        "MessageRetentionPeriod": 345600,
        "VisibilityTimeout": 5400,
        "ReceiveMessageWaitTimeSeconds": 20,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "IngestionDeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ]
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${ProjectName}-${Environment}-api"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "ApiExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ProjectName}-${Environment}-api"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "PermissionsBoundary": {
          "Fn::If": [
            "HasRoleBoundary",
            {
              "Ref": "ExecutionRolePermissionsBoundaryArn"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ],
        "Policies": [
          {
            "PolicyName": "KbApi",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadKnowledge",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/notes/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/attachments/*"
                    }
                  ]
                },
                {
                  "Sid": "WriteKnowledgeThroughBackendPolicy",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/notes/Ideas/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/notes/Resources/_Review/AI Learning/*"
                    }
                  ]
                },
                {
                  "Sid": "UpdateOrdinaryNotesConditionally",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {"Fn::Sub": "${DataBucket.Arn}/notes/Ideas/*"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/Projects/*"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/Areas/*"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/Resources/*"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/Personal Facts/*"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/Templates/*"}
                  ],
                  "Condition": {"Null": {"s3:if-match": "false"}}
                },
                {
                  "Sid": "ReadOrdinaryNoteHistoryForRecovery",
                  "Effect": "Allow",
                  "Action": "s3:ListBucketVersions",
                  "Resource": {"Fn::GetAtt": ["DataBucket", "Arn"]},
                  "Condition": {"StringLike": {"s3:prefix": [
                    "notes/Ideas/*", "notes/Projects/*", "notes/Areas/*",
                    "notes/Resources/*", "notes/Personal Facts/*", "notes/Templates/*"
                  ]}}
                },
                {
                  "Sid": "ProtectPoliciesAndSourceSnapshots",
                  "Effect": "Deny",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {"Fn::Sub": "${DataBucket.Arn}/notes/AGENTS.md"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/*/AGENTS.md"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/*/Source Snapshots/*"},
                    {"Fn::Sub": "${DataBucket.Arn}/notes/*/Source Archives/*"}
                  ]
                },
                {
                  "Sid": "ReadIndex",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${IndexBucket.Arn}/indexes/*"
                  }
                },
                {
                  "Sid": "ControlRecords",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ControlTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "EnqueueIngestion",
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "IngestionQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "FunctionLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-${Environment}-api:*"
                  }
                },
                {
                  "Fn::If": [
                    "HasAuthSecret",
                    {
                      "Effect": "Allow",
                      "Action": "secretsmanager:GetSecretValue",
                      "Resource": {
                        "Ref": "AuthSecretArn"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          },
          {
            "Fn::If": [
              "HasApprovedEmbeddingModel",
              {
                "PolicyName": "ApprovedQueryEmbedding",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": "bedrock:InvokeModel",
                      "Resource": {
                        "Ref": "ApprovedEmbeddingModelArn"
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "IngestionExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ProjectName}-${Environment}-ingestion"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "PermissionsBoundary": {
          "Fn::If": [
            "HasRoleBoundary",
            {
              "Ref": "ExecutionRolePermissionsBoundaryArn"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          }
        ],
        "Policies": [
          {
            "PolicyName": "KbIngestion",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ListMarkdownSources",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "DataBucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": "notes/*"
                    }
                  }
                },
                {
                  "Sid": "ReadSources",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/notes/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/attachments/*"
                    }
                  ]
                },
                {
                  "Sid": "PublishDerivedIndexes",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${IndexBucket.Arn}/indexes/*"
                  }
                },
                {
                  "Sid": "JobAndPublicationRecordsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ControlTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "OP#*",
                        "INDEX#*",
                        "JOB#*"
                      ]
                    },
                    "Null": {
                      "dynamodb:LeadingKeys": "false"
                    }
                  }
                },
                {
                  "Sid": "ConsumeIngestion",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "IngestionQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "FunctionLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-${Environment}-ingestion:*"
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "HasApprovedEmbeddingModel",
              {
                "PolicyName": "ApprovedDocumentEmbedding",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": "bedrock:InvokeModel",
                      "Resource": {
                        "Ref": "ApprovedEmbeddingModelArn"
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "IngestionLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${ProjectName}-${Environment}-ingestion"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "IngestionQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "IngestionQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowOnlyVaultNotifications",
              "Effect": "Allow",
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "IngestionQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${Environment}-vault-${AWS::AccountId}-${AWS::Region}"
                  }
                },
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "DataBucketName": {
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "IndexBucketName": {
      "Value": {
        "Ref": "IndexBucket"
      }
    },
    "ReleaseBucketName": {
      "Value": {
        "Ref": "ReleaseBucket"
      }
    },
    "ControlTableName": {
      "Value": {
        "Ref": "ControlTable"
      }
    },
    "IngestionQueueUrl": {
      "Value": {
        "Ref": "IngestionQueue"
      }
    },
    "IngestionQueueArn": {
      "Value": {
        "Fn::GetAtt": [
          "IngestionQueue",
          "Arn"
        ]
      }
    },
    "DeadLetterQueueUrl": {
      "Value": {
        "Ref": "IngestionDeadLetterQueue"
      }
    },
    "ApiExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ApiExecutionRole",
          "Arn"
        ]
      }
    },
    "IngestionExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "IngestionExecutionRole",
          "Arn"
        ]
      }
    },
    "AuthSecretArn": {
      "Value": {
        "Ref": "AuthSecretArn"
      }
    }
  }
}
